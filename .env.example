# NFL Flag Scraper Environment Variables
# Copy this file to .env and fill in your values

# TeamSnap API Credentials
TEAMSNAP_CLIENT_ID=your_client_id_here
TEAMSNAP_CLIENT_SECRET=your_client_secret_here
TEAMSNAP_ACCESS_TOKEN=your_access_token_here
TEAMSNAP_REFRESH_TOKEN=your_refresh_token_here

# Scraper Configuration
RATE_LIMIT=1.5
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"

# Output Configuration
OUTPUT_DIR=./output
CSV_DELIMITER=,
